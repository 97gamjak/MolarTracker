{
    "permissions": {
        "allow": [
            "Bash(cmake *)",
            "Bash(ninja *)",
            "Bash(ctest *)",
            "Bash(clang-format *)",
            "Bash(clang-tidy *)",
            "Bash(find *)",
            "Bash(grep *)",
            "Bash(ls *)",
            "Bash(cat *)",
            "Bash(git status*)",
            "Bash(git log *)",
            "Bash(git diff *)",
            "Bash(git fetch *)",
            "Bash(git branch)",
            "Bash(git branch -v*)",
            "Bash(git branch -a*)",
            "Bash(git checkout *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push -u origin *)",
            "Bash(git push origin *)",
            "Bash(git show *)",
            "Bash(git stash *)",
            "Read"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f *)",
            "Bash(git reset --hard *)",
            "Bash(git branch -D *)",
            "Bash(git clean -f*)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "git fetch origin 2>/dev/null || true",
                        "statusMessage": "Fetching remote branches..."
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "mcp__github__create_pull_request",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/enforce-pr-base.sh",
                        "statusMessage": "Enforcing PR base branch..."
                    }
                ]
            }
        ]
    }
}
